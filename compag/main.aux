\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Optimization and checkpoint-selection dynamics}{10}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Optimization behavior of the anchored representation and the matched detector study. (a) Training and internal source-group validation loss during 30 epochs of Mississippi DINOv2 feature distillation. The retained backbone is the minimum validation-loss artifact at epoch 23. (b) Alabama validation mAP50-95{} during 1024-pixel supervised fine-tuning. Thin paths are individual seeds; markers identify the checkpoint selected from each path. These panels document optimization and checkpoint selection, not a statistical superiority test.}}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:training_dynamics}{{3}{11}{Optimization behavior of the anchored representation and the matched detector study. (a) Training and internal source-group validation loss during 30 epochs of Mississippi DINOv2 feature distillation. The retained backbone is the minimum validation-loss artifact at epoch 23. (b) Alabama validation \metric {} during 1024-pixel supervised fine-tuning. Thin paths are individual seeds; markers identify the checkpoint selected from each path. These panels document optimization and checkpoint selection, not a statistical superiority test}{figure.caption.4}{}}
