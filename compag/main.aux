\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}What the anchored result means}{15}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pseudo-label retention audit on a fixed sample of 2,048 Mississippi images per seed. Only 4--7 images retained a pseudo-label after confidence and non-maximum-suppression filtering, corresponding to 0.195--0.342\% image coverage. All retained boxes belonged to the broiler-house class. The sparse, class-collapsed signal explains why pseudo-label losses were not stacked with the proposed anchored representation method.}}{16}{figure.caption.9}\protected@file@percent }
\newlabel{fig:pseudo_retention}{{6}{16}{Pseudo-label retention audit on a fixed sample of 2,048 Mississippi images per seed. Only 4--7 images retained a pseudo-label after confidence and non-maximum-suppression filtering, corresponding to 0.195--0.342\% image coverage. All retained boxes belonged to the broiler-house class. The sparse, class-collapsed signal explains why pseudo-label losses were not stacked with the proposed anchored representation method}{figure.caption.9}{}}
